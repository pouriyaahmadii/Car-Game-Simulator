<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CarGameSim"
    xmlns:controls="using:CarGameSim.Controls"
    mc:Ignorable="d"
    x:Class="CarGameSim.MainWindow"
    Width="1200"
    Height="760"
    MinWidth="1000"
    MinHeight="650"
    Title="Car Game Simulation - C#"
    Background="#F4F7FB">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="Slider">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="290,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1E293B"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <TextBlock Text="کنترل پروژه"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="دکمه‌ها"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#CBD5E1"
                               Margin="0,10,0,0"/>

                    <Button Name="StartButton" Content="شروع" Background="#16A34A"/>
                    <Button Name="PauseButton" Content="توقف / ادامه" Background="#F59E0B"/>
                    <Button Name="HornButton" Content="بوق" Background="#DC2626"/>
                    <Button Name="LightsButton" Content="چراغ" Background="#7C3AED"/>
                    <Button Name="ResetButton" Content="شروع مجدد" Background="#475569"/>

                    <TextBlock Text="تنظیم سرعت"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#CBD5E1"
                               Margin="0,18,0,0"/>

                    <Slider Name="SpeedSlider"
                            Minimum="1"
                            Maximum="15"
                            Value="5"/>

                    <TextBlock Text="رنگ خودرو"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#CBD5E1"
                               Margin="0,18,0,0"/>

                    <ComboBox Name="ColorCombo" SelectedIndex="0">
                        <ComboBoxItem Content="آبی"/>
                        <ComboBoxItem Content="قرمز"/>
                        <ComboBoxItem Content="سبز"/>
                        <ComboBoxItem Content="مشکی"/>
                        <ComboBoxItem Content="زرد"/>
                    </ComboBox>

                    <TextBlock Text="نوع خودرو"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#CBD5E1"
                               Margin="0,18,0,0"/>

                    <ComboBox Name="TypeCombo" SelectedIndex="0">
                        <ComboBoxItem Content="Sedan"/>
                        <ComboBoxItem Content="Sport"/>
                        <ComboBoxItem Content="Truck"/>
                    </ComboBox>

                    <Border Background="#334155"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,20,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="راهنمای کنترل"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="حرکت: کلیدهای جهت‌دار"
                                       Foreground="#E2E8F0"/>
                            <TextBlock Text="چراغ: کلید L"
                                       Foreground="#E2E8F0"/>
                            <TextBlock Text="بوق: کلید H"
                                       Foreground="#E2E8F0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="20">
            <!-- Status Card -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="14"
                    Padding="16"
                    BoxShadow="0 4 18 0 #22000000"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="وضعیت بازی"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="اطلاعات خودرو و وضعیت در همین بخش نمایش داده می‌شود."
                               Margin="0,6,0,0"
                               Foreground="#475569"/>
                </StackPanel>
            </Border>

            <!-- Game Container -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="18"
                    BoxShadow="0 6 24 0 #22000000">
                <controls:GameCanvas Name="GameView"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                    />
            </Border>
        </Grid>
    </Grid>
</Window>
